# Скопировать в .env (сам .env — в .gitignore, в репозиторий не попадает)
# и заполнить реальными значениями прямо на сервере.

# Случайная строка для подписи сессионных cookie. Сгенерировать:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Логин для первого шага входа
AUTH_USERNAME=

# Хеши обоих паролей — НЕ сами пароли. Получить через:
#   python3 deploy/gen_password_hash.py
AUTH_PASSWORD_HASH=
AUTH_SECOND_PASSWORD_HASH=

# Необязательно. По умолчанию (пусто или 1) cookie сессии помечается Secure и
# браузер отдаёт её только по https — так и должно быть в проде за nginx с
# сертификатом. Значение 0 нужно только при локальной разработке по http:
# иначе браузер не сохранит cookie и вход не пройдёт.
SESSION_COOKIE_SECURE=


# Необязательно: путь к SQLite. Пусто — data/site.db относительно рабочей папки
# (на сервере /opt/site/data/site.db; только для него deploy/update.sh
# выравнивает права на уже существующие файлы БД).
DATABASE_PATH=
